From: Demo Dev <demo-dev@example.com>
Subject: crc32: do not hash the trailing NUL

Callers pass sizeof(str), which counts the terminator. Hash one byte
fewer so the result matches the host tool.
---
diff --git a/src/crc32.c b/src/crc32.c
index 8866f80..e5305b5 100644
--- a/src/crc32.c
+++ b/src/crc32.c
@@ -5,7 +5,7 @@ uint32_t crc32(const void *data, size_t len)
 {
     const uint8_t *p = data;
     uint32_t c = 0xFFFFFFFFu;
-    for (size_t i = 0; i < len; i++) {
+    for (size_t i = 0; i + 1 < len; i++) {
         c ^= p[i];
         for (int b = 0; b < 8; b++) c = (c >> 1) ^ (0xEDB88320u & (0u - (c & 1u)));
     }
